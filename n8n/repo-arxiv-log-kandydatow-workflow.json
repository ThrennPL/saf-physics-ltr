      "name": "Normalizuj wejscie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\nconst fail = (detail) => [{ json: { valid: false, error: \"bad_request\", detail } }];\nconst topic = String(body.topic ?? \"\").trim();\nconst approvedBy = String(body.approved_by ?? \"\").trim();\nconst selected = body.selected;\nif (!topic) return fail(\"Brak parametru 'topic'.\");\nif (approvedBy.length < 2) return fail(\"Brak parametru 'approved_by' (kto zatwierdzil wybor).\");\nif (!Array.isArray(selected) || selected.length < 1 || selected.length > 20) {\n  return fail(\"Parametr 'selected' musi byc lista 1-20 publikacji z wyniku search_arxiv_literature.\");\n}\nconst publications = selected.map(p => ({\n  id: String(p.id ?? \"\"),\n  title: String(p.title ?? \"\"),\n  authors: String(p.authors ?? \"\"),\n  date: String(p.date ?? \"\"),\n  url: String(p.url ?? \"\"),\n}));\nreturn [{ json: { valid: true, payload: { topic, publications, approved_by: approvedBy } } }];"
      }
    },
